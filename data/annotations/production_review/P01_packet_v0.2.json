  "ambiguities_and_boundary_questions": {
    "CYBER002": [
      {
        "riu_ids": [
          "RIU-01",
          "RIU-02"
        ],
        "issue": "Confirm that changes at the breached site and other reuse sites are independently assessable; do not require every hypothetical account or a named password manager."
      },
      {
        "riu_ids": [
          "RIU-03"
        ],
        "issue": "Recovery and session revocation are conditional on observed compromise or provider guidance; no proof of compromise is supplied."
      }
    ],
    "CYBER073": [
      {
        "riu_ids": [
          "RIU-01"
        ],
        "issue": "Invalidation is mandatory; replacement is conditional on continued service need, not a required new credential when the key is no longer needed."
      },
      {
        "riu_ids": [
          "RIU-04"
        ],
        "issue": "Check whether coordinated history cleanup is proportionate; do not require destructive force-push or pretend every clone can be erased."
      }
    ],
    "CYBER080": [
      {
        "riu_ids": [
          "RIU-01"
        ],
        "issue": "Review whether the proposed isolation boundary provides proportionate compensating protection. Isolation is counted within this operational outcome, avoiding duplicate broad and narrow credit; no second unrelated control is compulsory."
      },
      {
        "riu_ids": [
          "RIU-03"
        ],
        "issue": "Review migration criticality and ordinal distinction. Accept an accountable migration next step and justified checkpoint; do not demand an invented guaranteed date."
      }
    ],
    "CYBER048": [
      {
        "riu_ids": [
          "RIU-01",
          "RIU-03"
        ],
        "issue": "Separate evidence collection/time-window reconstruction from the impact interpretation; no requirement to recover unavailable records or assert confirmed exfiltration."
      },
      {
        "riu_ids": [
          "RIU-04"
        ],
        "issue": "Review feasible evidence preservation alongside containment; no rigid order that leaves a public bucket exposed until exhaustive imaging finishes."
      }
    ],
    "CYBER037": [
      {
        "riu_ids": [
          "RIU-01",
          "RIU-03"
        ],
        "issue": "Inspect success/outcome versus corroborating post-access behavior as distinct evidence; no mandatory list of all telemetry fields."
      },
      {
        "riu_ids": [
          "RIU-04"
        ],
        "issue": "Check ordinal anchors and avoid requiring blanket blocking of every source or service shutdown."
      }
    ],
    "DEC062": [
      {
        "riu_ids": [
          "RIU-01",
          "RIU-02"
        ],
        "issue": "Do not split every possible metadata field into a mandatory RIU; examples are alternative diagnostics within definition and period checks."
      },
      {
        "riu_ids": [
          "RIU-04"
        ],
        "issue": "No universal rule that newer/official/larger is always correct; an explicitly deferred decision is valid."
      }
    ],
    "DEC080": [
      {
        "riu_ids": [
          "RIU-02",
          "RIU-03"
        ],
        "issue": "Clarity and respectful delivery are separately assessable joint objectives; do not require one prescribed feedback script."
      },
      {
        "riu_ids": [
          "RIU-01"
        ],
        "issue": "Cultural sensitivity must not become unsupported claims about whole national or ethnic groups."
      }
    ],
    "DEC076": [
      {
        "riu_ids": [
          "RIU-02",
          "RIU-03"
        ],
        "issue": "An include/omit decision rule is sufficient; no fabricated cause, deadline or exhaustive incident-template fields required."
      },
      {
        "riu_ids": [
          "RIU-04"
        ],
        "issue": "Check the boundary between useful uncertainty guidance and an unsolicited requirement to publish confidential internals."
      }
    ],
    "DEC087": [
      {
        "riu_ids": [
          "RIU-01",
          "RIU-03"
        ],
        "issue": "Root-cause evidence and the intervention choice are distinct; do not require deploying every option."
      },
      {
        "riu_ids": [
          "RIU-03"
        ],
        "issue": "Review ordinal partial credit: a substantive cause-response link can earn half; mentioning all four labels without a decision cannot."
      }
    ],
    "DEC027": [
      {
        "riu_ids": [
          "RIU-02",
          "RIU-04"
        ],
        "issue": "Distinguish assessing training burden from the final tradeoff judgment; no mandatory weighted scoring formula or numerical payback period."
      },
      {
        "riu_ids": [
          "RIU-03"
        ],
        "issue": "Check that compatibility examples remain alternatives rather than a compulsory exhaustive procurement checklist."
      }
    ],
    "SYN053": [
      {
        "riu_ids": [
          "RIU-01",
          "RIU-02"
        ],
        "issue": "Withhold unconditional completion without assuming every administrative approval always blocks all definitions of completion."
      },
      {
        "riu_ids": [
          "RIU-03"
        ],
        "issue": "Do not require a fabricated approver identity or assert that approval has been granted."
      }
    ],
    "SYN020": [
      {
        "riu_ids": [
          "RIU-01",
          "RIU-02"
        ],
        "issue": "Keep each relational comparison together; do not separately score every number and duplicate its directional claim."
      },
      {
        "riu_ids": [
          "RIU-04"
        ],
        "issue": "A balanced tradeoff meets the negative constraint without explicitly saying no universal winner; a refusal/nonanswer still scores 0."
      }
    ],
    "SYN045": [
      {
        "riu_ids": [
          "RIU-01"
        ],
        "issue": "Completed account disablement should be recognized in content but not counted again as a new instruction."
      },
      {
        "riu_ids": [
          "RIU-03"
        ],
        "issue": "The note does not prescribe a precise device-review deadline; accept immediate assessment or an explicit follow-up path that does not ignore it."
      }
    ],
    "SYN065": [
      {
        "riu_ids": [
          "RIU-03"
        ],
        "issue": "A complete interpretation must distinguish outcome dimensions; do not require a formal utility function or assert the launch caused either change."
      }
    ],
    "SYN077": [
      {
        "riu_ids": [
          "RIU-03"
        ],
        "issue": "EN/BN/BN-CS all say rollback is tested then explicitly that testing failed; review the operational reading that passing readiness, rather than mere test execution, is required."
      },
      {
        "riu_ids": [
          "RIU-03",
          "RIU-04"
        ],
        "issue": "Failed-condition evidence and no-go conclusion are distinct; do not require an invented rollback repair procedure."
      }
    ],
    "PROC092": [
      {
        "riu_ids": [
          "RIU-02"
        ],
        "issue": "Accept any feasible alternative; do not require finding a new speaker when none is available."
      },
      {
        "riu_ids": [
          "RIU-03",
          "RIU-04"
        ],
        "issue": "Notification and update of shared meeting records are distinct; a single message/invite update may express both propositions."
      }
    ],
    "PROC060": [
      {
        "riu_ids": [
          "RIU-02",
          "RIU-03"
        ],
        "issue": "Review conflict checking versus committed reservation/confirmation as distinct operational outcomes; no requirement for software locking syntax."
      },
      {
        "riu_ids": [
          "RIU-04",
          "RIU-05"
        ],
        "issue": "Change and cancellation are independently assessable lifecycle paths, not a mandatory platform feature list."
      }
    ],
    "PROC026": [
      {
        "riu_ids": [
          "RIU-01",
          "RIU-04"
        ],
        "issue": "Distinguish a common argument/outline from final cross-section integration; do not double-count a mere instruction to use the outline."
      },
      {
        "riu_ids": [
          "RIU-02"
        ],
        "issue": "Four students all need meaningful responsibility; exact equality of words or one section per person is not required."
      }
    ],
    "PROC003": [
      {
        "riu_ids": [
          "RIU-01"
        ],
        "issue": "A separate copy is valid even if the copy itself is editable; the prompt protects the original, not necessarily all derivative copies."
      },
      {
        "riu_ids": [
          "RIU-02",
          "RIU-03"
        ],
        "issue": "Do not impose exact file format, password or export settings; review whether accessibility is preserved by the selected method."
      }
    ],
    "PROC037": [
      {
        "riu_ids": [
          "RIU-01",
          "RIU-04"
        ],
        "issue": "Input gathering and the resulting scheduling logic are distinct; no invented exact itinerary is required."
      },
      {
        "riu_ids": [
          "RIU-04"
        ],
        "issue": "Review ordinal anchor and allow a valid conditional planning algorithm instead of requiring numeric times that the prompt does not provide."
      }
    ],
    "TECH082": [
      {
        "riu_ids": [
          "RIU-01",
          "RIU-04"
        ],
        "issue": "A displayed numeric format is not proof of numeric storage; a small test is supporting, not a compulsory repair of the whole sheet."
      },
      {
        "riu_ids": [
          "RIU-02",
          "RIU-03"
        ],
        "issue": "Character contamination and locale/separator mismatch are distinct diagnostic routes; do not require all examples or assume a specific locale."
      }
    ],
    "TECH050": [
      {
        "riu_ids": [
          "RIU-01",
          "RIU-05"
        ],
        "issue": "Resource-specific leak evidence and a cross-signal time series are distinct; the same memory metric alone cannot fully satisfy observability correlation."
      },
      {
